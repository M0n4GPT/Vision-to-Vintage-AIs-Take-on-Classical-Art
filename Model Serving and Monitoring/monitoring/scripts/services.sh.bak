#!/bin/bash

# Exit on error
set -e

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Get the root directory of the project
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

# --- VENV AUTOMATION ---
VENV_DIR="$ROOT_DIR/venv"
PYTHON_BIN="python3"

if [ ! -d "$VENV_DIR" ]; then
    echo -e "${YELLOW}Creating Python virtual environment in $VENV_DIR...${NC}"
    $PYTHON_BIN -m venv $VENV_DIR
fi

# Always activate venv for this script
source $VENV_DIR/bin/activate
export VIRTUAL_ENV_DISABLE_PROMPT=1

echo -e "${GREEN}Using Python from: $(which python)${NC}"
echo -e "${GREEN}Using pip from: $(which pip)${NC}"
echo -e "${GREEN}Using mlflow from: $(which mlflow)${NC}"

# Function to handle cleanup on exit
cleanup() {
    echo -e "\n${YELLOW}Received interrupt signal. Cleaning up...${NC}"
    stop_services
    exit 0
}

# Set up trap for SIGINT (Ctrl+C)
trap cleanup SIGINT

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to check if a service is running
is_service_running() {
    local port=$1
    if lsof -i :$port >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# Function to kill process on port
kill_port() {
    local port=$1
    local service=$2
    echo -e "${YELLOW}Checking for existing $service process on port $port...${NC}"
    
    # Try to find the process
    local pid=$(lsof -ti :$port)
    if [ ! -z "$pid" ]; then
        echo -e "${YELLOW}Found $service process (PID: $pid) on port $port${NC}"
        
        # Try graceful shutdown first
        echo -e "${YELLOW}Attempting graceful shutdown of $service...${NC}"
        kill -TERM $pid
        
        # Wait for process to terminate
        for i in {1..5}; do
            if ! lsof -ti :$port >/dev/null; then
                echo -e "${GREEN}$service stopped gracefully${NC}"
                return 0
            fi
            sleep 1
        done
        
        # Force kill if still running
        echo -e "${YELLOW}Force stopping $service...${NC}"
        kill -9 $pid
        sleep 1
        
        # Verify process is killed
        if lsof -ti :$port >/dev/null; then
            echo -e "${RED}Failed to kill $service process${NC}"
            return 1
        fi
    fi
    return 0
}

# Function to setup environment
setup_environment() {
    echo -e "${YELLOW}Setting up environment...${NC}"
    
    # Check required commands
    for cmd in docker docker-compose python3 pip; do
        if ! command_exists $cmd; then
            echo -e "${RED}Error: $cmd is not installed${NC}"
            exit 1
        fi
    done
    
    # Create necessary directories
    echo -e "${YELLOW}Creating necessary directories...${NC}"
    mkdir -p "$ROOT_DIR/logs"
    mkdir -p "$ROOT_DIR/data/metrics"
    mkdir -p "$ROOT_DIR/data/styles"
    mkdir -p "$ROOT_DIR/tfhub_cache"
    mkdir -p "$ROOT_DIR/mlruns"
    
    # Install Python dependencies
    echo -e "${YELLOW}Installing Python dependencies...${NC}"
    pip install -r "$ROOT_DIR/requirements.txt"
    
    echo -e "${GREEN}Environment setup complete!${NC}"
}

# Function to start services
start_services() {
    echo -e "${YELLOW}Starting services...${NC}"
    
    # Kill existing processes
    kill_port 8000 "FastAPI"
    kill_port 5000 "MLflow"
    
    # Start monitoring stack
    echo -e "${YELLOW}Starting monitoring stack...${NC}"
    cd "$ROOT_DIR/monitoring"
    docker compose -f docker-compose.yml up -d
    cd "$ROOT_DIR"
    echo -e "${YELLOW}Waiting for services to be ready...${NC}"
    sleep 5
    
    echo -e "${GREEN}All services started successfully!${NC}"
    echo -e "Available endpoints:"
    echo -e "FastAPI:     http://localhost:8000"
    echo -e "Prometheus:  http://localhost:9090"
    echo -e "Grafana:     http://localhost:3000"
    echo -e "MLflow:      http://localhost:5000"
    echo -e "\nAPI Documentation:"
    echo -e "Swagger UI:  http://localhost:8000/docs"
    echo -e "ReDoc:       http://localhost:8000/redoc"
    echo -e "\nPrometheus logs: docker logs -f prometheus"
    echo -e "Grafana logs:    docker logs -f grafana"
    echo -e "MLflow logs:     docker logs -f monitoring-mlflow-1"
    echo -e "\nPress Ctrl+C to stop all services"
    
    # Start FastAPI in foreground (logs visible)
    trap 'echo -e "\n${YELLOW}Stopping all services...${NC}"; stop_services; exit 0' SIGINT
    cd "$ROOT_DIR"
    uvicorn app.main:app --host 0.0.0.0 --port 8000 --log-level info
}

# Function to stop services
stop_services() {
    echo -e "${YELLOW}Stopping all services...${NC}"
    
    # Stop FastAPI gracefully
    if [ -f .fastapi.pid ]; then
        pid=$(cat .fastapi.pid)
        if ps -p $pid > /dev/null; then
            echo -e "${YELLOW}Stopping FastAPI (PID: $pid)...${NC}"
            kill -TERM $pid
            # Wait for process to terminate
            for i in {1..10}; do
                if ! ps -p $pid > /dev/null; then
                    break
                fi
                sleep 1
            done
            # Force kill if still running
            if ps -p $pid > /dev/null; then
                echo -e "${YELLOW}Force stopping FastAPI...${NC}"
                kill -9 $pid
            fi
            rm .fastapi.pid
        fi
    fi
    
    # Stop MLflow server
    if [ -f .mlflow.pid ]; then
        pid=$(cat .mlflow.pid)
        if ps -p $pid > /dev/null; then
            echo -e "${YELLOW}Stopping MLflow server (PID: $pid)...${NC}"
            kill -TERM $pid
            # Wait for process to terminate
            for i in {1..10}; do
                if ! ps -p $pid > /dev/null; then
                    break
                fi
                sleep 1
            done
            # Force kill if still running
            if ps -p $pid > /dev/null; then
                echo -e "${YELLOW}Force stopping MLflow server...${NC}"
                kill -9 $pid
            fi
            rm .mlflow.pid
        fi
    fi
    
    # Stop monitoring stack
    cd "$ROOT_DIR/monitoring"
    docker-compose down
    cd "$ROOT_DIR"
    
    echo -e "${GREEN}All services stopped${NC}"
}

# Function to run tests
run_tests() {
    echo -e "${YELLOW}Running model degradation tests...${NC}"
    python tests/test_model_degradation.py
}

# Function to show status
show_status() {
    echo -e "${YELLOW}Service Status:${NC}"
    
    if is_service_running 8000; then
        echo -e "${GREEN}✓ FastAPI is running on port 8000${NC}"
    else
        echo -e "${RED}✗ FastAPI is not running${NC}"
    fi
    
    if is_service_running 5000; then
        echo -e "${GREEN}✓ MLflow server is running on port 5000${NC}"
    else
        echo -e "${RED}✗ MLflow server is not running${NC}"
    fi
    
    if is_service_running 9090; then
        echo -e "${GREEN}✓ Prometheus is running on port 9090${NC}"
    else
        echo -e "${RED}✗ Prometheus is not running${NC}"
    fi
    
    if is_service_running 3000; then
        echo -e "${GREEN}✓ Grafana is running on port 3000${NC}"
    else
        echo -e "${RED}✗ Grafana is not running${NC}"
    fi
}

# Main script logic
case "$1" in
    "setup")
        setup_environment
        ;;
    "start")
        start_services
        ;;
    "stop")
        stop_services
        ;;
    "test")
        run_tests
        ;;
    "status")
        show_status
        ;;
    *)
        echo "Usage: $0 {setup|start|stop|test|status}"
        echo "  setup   - Install dependencies and setup environment"
        echo "  start   - Start all services"
        echo "  stop    - Stop all services"
        echo "  test    - Run model degradation tests"
        echo "  status  - Show service status"
        exit 1
        ;;
esac 